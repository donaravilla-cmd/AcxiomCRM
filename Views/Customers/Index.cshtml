@model IEnumerable<Customer>
<div class="d-flex justify-content-between mb-3"><h2>Customers</h2><a class="btn btn-primary" asp-action="Create">+ Add Customer</a></div><form class="mb-3"><input name="q" class="form-control" placeholder="Search name, email, phone or company"/></form><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CustomerName</td><td>@x.Email</td><td>@x.Phone</td><td>@x.CompanyName</td><td>@x.Status</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a> <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline"><button class="btn btn-sm btn-link text-danger" onclick="return confirm('Delete this customer?')">Delete</button></form></td></tr>}</tbody></table>
