@model Customer
<h2>Edit Customer</h2><form method="post"><input type="hidden" asp-for="Id"/><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="CustomerName"></label><input asp-for="CustomerName" class="form-control"/></div><div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div><div class="mb-3"><label asp-for="CompanyName"></label><input asp-for="CompanyName" class="form-control"/></div><div class="mb-3"><label asp-for="Address"></label><input asp-for="Address" class="form-control"/></div><div class="mb-3"><label asp-for="City"></label><input asp-for="City" class="form-control"/></div><div class="mb-3"><label asp-for="State"></label><input asp-for="State" class="form-control"/></div><button class="btn btn-primary">Update</button></form>
