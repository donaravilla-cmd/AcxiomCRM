@model IEnumerable<Opportunity>
<div class="d-flex justify-content-between mb-3"><h2>Opportunities</h2><a class="btn btn-primary" asp-action="Create">+ Add Opportunity</a></div><table class="table table-striped"><thead><tr><th>Name</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Stage</th><th>Close date</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OpportunityName</td><td>@x.Amount</td><td>@x.Probability%</td><td>@x.WeightedValue</td><td>@x.Stage</td><td>@x.ExpectedCloseDate.ToShortDateString()</td></tr>}</tbody></table>
