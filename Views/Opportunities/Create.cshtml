@model Opportunity
<h2>Add Opportunity</h2><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="OpportunityName"></label><input asp-for="OpportunityName" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Amount"></label><input asp-for="Amount" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="mb-3"><label asp-for="Probability"></label><input asp-for="Probability" class="form-control"/><span asp-validation-for="Probability" class="text-danger"></span></div><div class="mb-3"><label asp-for="Stage"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="mb-3"><label asp-for="ExpectedCloseDate"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control"/><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><button class="btn btn-primary">Save</button></form>
