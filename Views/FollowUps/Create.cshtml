@model FollowUp
<h2>Schedule Follow-up</h2><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="FollowUpDate"></label><input asp-for="FollowUpDate" type="date" class="form-control"/><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="mb-3"><label asp-for="FollowUpType"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="mb-3"><label asp-for="Remarks"></label><textarea asp-for="Remarks" class="form-control"></textarea></div><div class="mb-3"><label asp-for="AssignedTo"></label><input asp-for="AssignedTo" class="form-control"/></div><button class="btn btn-primary">Save</button></form>
