@model IEnumerable<FollowUp>
<div class="d-flex justify-content-between mb-3"><h2>Follow-ups</h2><a class="btn btn-primary" asp-action="Create">+ Schedule Follow-up</a></div><table class="table table-striped"><thead><tr><th>Date</th><th>Type</th><th>Remarks</th><th>Status</th><th>Assigned To</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FollowUpDate.ToShortDateString()</td><td>@x.FollowUpType</td><td>@x.Remarks</td><td>@x.Status</td><td>@x.AssignedTo</td></tr>}</tbody></table>
