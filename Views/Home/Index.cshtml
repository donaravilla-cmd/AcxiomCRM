@{ViewData["Title"]="Dashboard";}
<h2 class="mb-4">CRM Dashboard</h2><div class="row g-3"><div class="col-md"><div class="card metric"><div class="card-body"><div class="text-muted">Customers</div><h2>@ViewBag.Customers</h2></div></div></div><div class="col-md"><div class="card metric"><div class="card-body"><div class="text-muted">Leads</div><h2>@ViewBag.Leads</h2></div></div></div><div class="col-md"><div class="card metric"><div class="card-body"><div class="text-muted">Open Opportunities</div><h2>@ViewBag.OpenOpps</h2></div></div></div><div class="col-md"><div class="card metric"><div class="card-body"><div class="text-muted">Won</div><h2>@ViewBag.Won</h2></div></div></div><div class="col-md"><div class="card metric"><div class="card-body"><div class="text-muted">Pipeline Value</div><h2>@(((decimal)ViewBag.Pipeline).ToString("C0"))</h2></div></div></div></div><div class="card mt-4"><div class="card-body"><h5>Lead Status</h5><canvas id="leadChart" height="100"></canvas></div></div>
@section Scripts{<script>new Chart(document.getElementById('leadChart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LeadLabels)),datasets:[{label:'Leads',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LeadValues))}]},options:{responsive:true}});</script>}
