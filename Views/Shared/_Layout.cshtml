@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">AcxiomCRM</a>

        <div class="navbar-nav flex-row flex-wrap gap-3">
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a>
                <a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a>
                <a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a>
                <a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a>
                <a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a>

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" asp-controller="AuditLogs" asp-action="Index">Audit</a>
                    <a class="nav-link" asp-controller="Users" asp-action="Index">User Management</a>
                }
            }
        </div>

        <div class="ms-auto">
            <partial name="_LoginPartial" />
        </div>
    </div>
</nav>

<main class="container py-4">
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
